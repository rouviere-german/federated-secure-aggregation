# Secrets: only .env.example is committed.
.env
.env.*
!.env.example

# Federation key material, created by scripts/generate_identities.py. Private Ed25519 keys:
# never commit these, and never bake them into an image.
secrets/
*_identity.json
roster.json

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
sbom*.json
requirements-audit.txt

# Runtime state, artifacts and large generated data
var/
artifacts/
data/generated/
mlruns/
*.parquet
*.npz
cassettes/*.local.jsonl
bench/results/latest.json

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
