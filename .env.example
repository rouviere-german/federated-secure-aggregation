# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=federated-secure-aggregation
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys, split by role.
# Generate a key with: uv run federated-secure-aggregation generate-api-key
# The coordinator stores only digests. The *raw* key is read from APP_API_KEY by the `silo`
# and `operate` subcommands; it is not a service setting and so is not listed as one here.
#
# Issue ONE key per identity. A shared key makes the "operator routes" a label rather than a
# control (any silo could open rounds and drive stage advances) and collapses the rate limit,
# because the token bucket is keyed on the presented key.
# Silo (participant) keys: the four protocol message routes and the share inbox.
APP_API_KEY_SHA256=
# Operator keys: POST /v1/rounds and POST /v1/rounds/advance only. A digest may not appear in
# both lists.
APP_OPERATOR_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
# Per authenticated key, so size these for ONE identity's polling, not for the whole stack.
# A silo polls the round status about 4 times a second at the shipped poll interval; the
# compose coordinator raises these to 50/200 to leave headroom for six such identities.
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Secure aggregation. Key material is mounted read-only and never committed; generate it with
# `uv run python scripts/generate_identities.py --out secrets/`.
APP_COORDINATOR_IDENTITY_PATH=secrets/coordinator_identity.json
APP_ROSTER_PATH=secrets/roster.json
APP_MODEL_DIMENSION=13
APP_SECAGG_THRESHOLD=3
APP_CLIP_NORM=1.0
APP_STAGE_TIMEOUT_SECONDS=30

# Central differential privacy over the aggregate.
APP_NOISE_MULTIPLIER=2.8536
APP_TARGET_EPSILON=8.0
APP_TARGET_DELTA=0.00001

APP_DATA_DIR=var
